{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/ResearchFreeFormRecordMember",
  "definitions": {
    "ResearchFreeFormRecordMember": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "research-free-form-record-member"
          ],
          "description": "The message name — <name> in the routing key."
        },
        "domain": {
          "type": "string",
          "enum": [
            "research"
          ],
          "description": "Throwaway domain, this branch only."
        },
        "kind": {
          "type": "string",
          "enum": [
            "event"
          ],
          "description": "Which exchange carries this message."
        },
        "ts": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$",
          "description": "The PUBLISH instant, ISO-8601 UTC."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "A fixed field beside the bag."
        },
        "properties": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {},
          "description": "Open bag: host-defined keys, unknown value shape."
        }
      },
      "required": [
        "type",
        "domain",
        "kind",
        "ts",
        "name",
        "properties"
      ],
      "additionalProperties": false,
      "description": "Candidate A: record<string, unknown> nested beside fixed fields."
    }
  }
}
