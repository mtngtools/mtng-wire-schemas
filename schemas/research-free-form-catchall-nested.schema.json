{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/ResearchFreeFormCatchallNested",
  "definitions": {
    "ResearchFreeFormCatchallNested": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "research-free-form-catchall-nested"
          ],
          "description": "The message name — <name> in the routing key."
        },
        "domain": {
          "type": "string",
          "enum": [
            "research"
          ],
          "description": "Throwaway domain, this branch only."
        },
        "kind": {
          "type": "string",
          "enum": [
            "event"
          ],
          "description": "Which exchange carries this message."
        },
        "ts": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$",
          "description": "The PUBLISH instant, ISO-8601 UTC."
        },
        "group": {
          "type": "object",
          "properties": {
            "label": {
              "type": "string",
              "minLength": 1,
              "description": "A fixed field inside the otherwise-open group."
            }
          },
          "required": [
            "label"
          ],
          "additionalProperties": {},
          "title": "FreeFormGroup",
          "description": "A nested group: one fixed field, plus whatever else the host attaches."
        }
      },
      "required": [
        "type",
        "domain",
        "kind",
        "ts",
        "group"
      ],
      "additionalProperties": false,
      "description": "Candidate C: catchall(unknown) on a nested group, envelope itself stays strict."
    }
  }
}
