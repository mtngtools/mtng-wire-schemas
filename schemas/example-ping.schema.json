{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": "STUB — illustrative target shape, not verified generator output. See schemas/README.md.",
  "$ref": "#/definitions/ExamplePing",
  "definitions": {
    "ExamplePing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "description": "Monotonic sequence number for this ping stream."
        },
        "sentAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO-8601 UTC timestamp the ping was emitted."
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "description": "Opaque sender id (app instance)."
        }
      },
      "required": ["sequence", "sentAt", "source"]
    }
  }
}
